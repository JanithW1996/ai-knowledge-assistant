# Safe configuration template
# Copy to .env for local work.
# Never commit the real .env file.

# Document repository: local or azure
DOCUMENT_REPOSITORY=local

# Required when DOCUMENT_REPOSITORY=azure
# This URL is an identifier, not a secret.
AZURE_STORAGE_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net
AZURE_STORAGE_CONTAINER=knowledge-documents

# Client ID of the user-assigned managed identity.
# This is an identifier, not a secret.
AZURE_MANAGED_IDENTITY_CLIENT_ID=

# Local development defaults
APP_ENVIRONMENT=development
IDENTITY_MODE=demo

# Azure App Service production settings must instead use:
# APP_ENVIRONMENT=production
# IDENTITY_MODE=entra
# DOCUMENT_REPOSITORY=azure
#
# Production must also enable built-in Microsoft Entra
# authentication before the application is started.
#
# Never place passwords, storage keys, client secrets,
# access tokens or real organisational data in this file.