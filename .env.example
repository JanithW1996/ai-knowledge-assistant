# Safe configuration template — do not add secret values

# Document source: local or azure
DOCUMENT_REPOSITORY=local

# Required when DOCUMENT_REPOSITORY=azure
AZURE_STORAGE_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net
AZURE_STORAGE_CONTAINER=knowledge-documents

# Used by an Azure-hosted app with the user-assigned managed identity
AZURE_MANAGED_IDENTITY_CLIENT_ID=